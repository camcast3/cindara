<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cindara.Desktop.ViewModels"
             xmlns:loc="using:Cindara.Desktop.Localization"
             x:Class="Cindara.Desktop.Views.SearchBrowserView"
             x:DataType="vm:SearchBrowserViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid x:Name="SearchEntry" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBox x:Name="SearchTextBox"
                     MaxLength="200"
                     Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{loc:Tr Search.Placeholder}"
                     AutomationProperties.Name="{loc:Tr Search.Name}"
                     AutomationProperties.HelpText="{loc:Tr Search.Help}" />
            <Button x:Name="SearchKeyboardButton" Grid.Column="1"
                    MinWidth="48" MinHeight="48"
                    Content="{loc:Tr Search.Keyboard}"
                    AutomationProperties.Name="{loc:Tr Search.Keyboard}"
                    Click="OnKeyboardClicked" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock Classes="secondary" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Classes="caption" Text="{Binding CountDescription}"
                       AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="CancelSearch" Content="{loc:Tr Action.CancelLoading}"
                        Margin="0,0,16,8" IsVisible="{Binding IsLoading}"
                        Click="OnCancelClicked" />
                <Button x:Name="CancelMore" Content="{loc:Tr Action.CancelLoading}"
                        Margin="0,0,16,8" IsVisible="{Binding IsLoadingMore}"
                        Click="OnCancelClicked" />
                <Button x:Name="RetrySearch" Content="{loc:Tr Search.Retry}"
                        Margin="0,0,16,8" IsVisible="{Binding CanRetry}"
                        Command="{Binding RetryCommand}" />
                <Button x:Name="RetryMore" Content="{loc:Tr Search.RetryMore}"
                        Margin="0,0,16,8" IsVisible="{Binding CanRetryMore}"
                        Command="{Binding RetryCommand}" />
                <Button Content="{loc:Tr Library.RetryArtwork}" IsVisible="{Binding CanRetryArtwork}"
                        Command="{Binding RetryArtworkCommand}" />
            </WrapPanel>
        </StackPanel>

        <ListBox x:Name="SearchRows" Grid.Row="2" Classes="library-grid"
                 ItemsSource="{Binding Rows}" SelectionMode="Single"
                 Background="Transparent" BorderThickness="0" Padding="6,4,6,8">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LibraryGridRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Cindara.Media.GridSpacing}"
                                Margin="{DynamicResource Cindara.Media.GridCardMargin}">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{DynamicResource Cindara.Media.GridSpacing}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MediaPreviewCardViewModel">
                                    <StackPanel Spacing="7" Width="{DynamicResource Cindara.Media.GridPosterWidth}">
                                        <Button Classes="card search-card"
                                                Height="{DynamicResource Cindara.Media.GridPosterHeight}"
                                                AutomationProperties.Name="{Binding Name}"
                                                AutomationProperties.HelpText="{Binding Subtitle}"
                                                GotFocus="OnCardFocused" Click="OnCardClicked">
                                            <Border ClipToBounds="True"
                                                    CornerRadius="{DynamicResource Cindara.Radius.Medium}">
                                                <Grid>
                                                    <Border IsVisible="{Binding IsArtworkLoading}"
                                                            Background="{DynamicResource Cindara.Brush.SurfaceRaised}"
                                                            Opacity="0.55" />
                                                    <TextBlock Text="{Binding ArtworkPlaceholder}"
                                                               IsVisible="{Binding ShowArtworkPlaceholder}"
                                                               TextWrapping="Wrap" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Margin="12" />
                                                    <Image Source="{Binding Artwork}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                                   Opacity="{Binding MetadataOpacity}"
                                                   Height="{DynamicResource Cindara.Media.GridTitleHeight}"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="caption" Text="{Binding Subtitle}"
                                                   Opacity="{Binding MetadataOpacity}" TextWrapping="Wrap"
                                                   Height="{DynamicResource Cindara.Media.GridSubtitleHeight}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
