<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cindara.Desktop.ViewModels"
             xmlns:loc="using:Cindara.Desktop.Localization"
             x:Class="Cindara.Desktop.Views.LibraryBrowserView"
             x:DataType="vm:LibraryBrowserViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="14">
        <StackPanel Spacing="8">
            <Grid x:Name="LibraryToolbar" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="FilterMenuButton" Margin="0,0,12,8" MinHeight="48"
                            IsEnabled="{Binding !IsAnyLoading}"
                            AutomationProperties.Name="{Binding FilterAccessibleName}"
                            Click="OnFilterMenuClicked">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding FilterLabel}" TextWrapping="Wrap" />
                            <PathIcon Grid.Column="1" Width="14" Height="14"
                                      VerticalAlignment="Center"
                                      Data="M 2,6 L 10,14 L 18,6 L 20,8 L 10,18 L 0,8 Z" />
                        </Grid>
                    </Button>
                    <Button x:Name="SortMenuButton" Margin="0,0,12,8" MinHeight="48"
                            IsEnabled="{Binding !IsAnyLoading}"
                            AutomationProperties.Name="{Binding SortAccessibleName}"
                            Click="OnSortMenuClicked">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="{Binding SortLabel}" TextWrapping="Wrap" />
                            <PathIcon Grid.Column="1" Width="14" Height="14"
                                      VerticalAlignment="Center"
                                      Data="M 2,6 L 10,14 L 18,6 L 20,8 L 10,18 L 0,8 Z" />
                        </Grid>
                    </Button>
                </WrapPanel>
                <TextBlock x:Name="LibraryItemCount" Grid.Column="1" Classes="caption"
                           Text="{Binding ItemCountDescription}" VerticalAlignment="Center"
                           Margin="0,0,12,8" AutomationProperties.LiveSetting="Polite" />
            </Grid>
            <TextBlock Classes="secondary" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Classes="secondary" Text="{loc:Tr Library.Empty}" IsVisible="{Binding IsEmpty}" />
            <TextBlock Classes="caption" Text="{Binding ArtworkMessage}"
                       IsVisible="{Binding HasArtworkError}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="RetryLibraryLoading" Content="{loc:Tr Library.Retry}"
                        Margin="0,0,16,8" Command="{Binding RetryPageCommand}"
                        IsVisible="{Binding CanRetry}" />
                <Button x:Name="RetryLibraryArtwork" Content="{loc:Tr Library.RetryArtwork}"
                        Margin="0,0,16,8" Command="{Binding LoadArtworkCommand}"
                        IsVisible="{Binding CanRetryArtwork}" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ListBox x:Name="LibraryRows" Classes="library-grid" ItemsSource="{Binding Rows}"
                     SelectionMode="Single" IsEnabled="{Binding !IsLoading}"
                     Background="Transparent" BorderThickness="0"
                     Padding="6,4,6,8">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryGridRowViewModel">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{DynamicResource Cindara.Media.GridSpacing}"
                                    Margin="{DynamicResource Cindara.Media.GridCardMargin}">
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{DynamicResource Cindara.Media.GridSpacing}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LibraryGridSlotViewModel">
                                        <Grid Classes="library-slot"
                                              Width="{DynamicResource Cindara.Media.GridPosterWidth}">
                                            <ContentControl Content="{Binding Item}"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Top"
                                                            IsVisible="{Binding HasItem}">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate x:DataType="vm:MediaPreviewCardViewModel">
                                                        <StackPanel Spacing="7">
                                                            <Button Classes="card"
                                                                    Height="{DynamicResource Cindara.Media.GridPosterHeight}"
                                                                    HorizontalAlignment="Stretch"
                                                                    AutomationProperties.Name="{Binding Name}"
                                                                    AutomationProperties.HelpText="{Binding Subtitle}"
                                                                    GotFocus="OnCardFocused"
                                                                    Click="OnCardClicked">
                                                                <Border ClipToBounds="True"
                                                                        CornerRadius="{DynamicResource Cindara.Radius.Medium}">
                                                                    <Grid>
                                                                        <Border IsVisible="{Binding IsArtworkLoading}"
                                                                                Background="{DynamicResource Cindara.Brush.SurfaceRaised}"
                                                                                Opacity="0.55" />
                                                                        <TextBlock Text="{Binding ArtworkPlaceholder}"
                                                                                   IsVisible="{Binding ShowArtworkPlaceholder}"
                                                                                   TextWrapping="Wrap"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="12" />
                                                                        <Image Source="{Binding Artwork}"
                                                                               Stretch="UniformToFill" />
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                                                       Height="{DynamicResource Cindara.Media.GridTitleHeight}"
                                                                       LineHeight="{DynamicResource Cindara.Media.GridTitleLineHeight}"
                                                                       Opacity="{Binding MetadataOpacity}"
                                                                       MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="caption"
                                                                       Text="{Binding Subtitle}"
                                                                       Height="{DynamicResource Cindara.Media.GridSubtitleHeight}"
                                                                       LineHeight="{DynamicResource Cindara.Media.GridSubtitleHeight}"
                                                                       Opacity="{Binding MetadataOpacity}"
                                                                       TextWrapping="Wrap" MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                            <StackPanel Spacing="7" IsVisible="{Binding IsPlaceholder}">
                                                <Border Height="{DynamicResource Cindara.Media.GridPosterHeight}"
                                                        Background="{DynamicResource Cindara.Brush.SurfaceRaised}"
                                                        CornerRadius="{DynamicResource Cindara.Radius.Medium}"
                                                        Opacity="0.55" />
                                                <Border Height="{DynamicResource Cindara.Media.GridTitleHeight}"
                                                        Background="Transparent" />
                                                <Border Height="{DynamicResource Cindara.Media.GridSubtitleHeight}"
                                                        Background="Transparent" />
                                            </StackPanel>
                                            <StackPanel Spacing="7" IsVisible="{Binding IsRetry}">
                                                <Button x:Name="RetryLoadingMore"
                                                        Height="{DynamicResource Cindara.Media.GridPosterHeight}"
                                                        HorizontalAlignment="Stretch"
                                                        Content="{loc:Tr Library.RetryMore}"
                                                        Click="OnRetryMoreClicked" />
                                                <Border Height="{DynamicResource Cindara.Media.GridTitleHeight}" />
                                                <Border Height="{DynamicResource Cindara.Media.GridSubtitleHeight}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LetterChoices" Spacing="2" />
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
