<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cindara.Desktop.ViewModels"
             xmlns:core="using:Cindara.Core.Jellyfin"
             xmlns:loc="using:Cindara.Desktop.Localization"
             x:Class="Cindara.Desktop.Views.LibraryBrowserView"
             x:DataType="vm:LibraryBrowserViewModel">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="LibraryChoices" ItemsSource="{Binding Libraries}"
                          IsEnabled="{Binding !IsLoading}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:MediaLibrary">
                        <Button Content="{Binding Name}" Click="OnLibraryClicked"
                                MinHeight="48" MaxWidth="500"
                                AutomationProperties.Name="{Binding Name}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Spacing="8">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="FilterAllButton" Content="{loc:Tr Library.Filter.All}"
                        Tag="All" Margin="0,0,10,8" Click="OnFilterClicked" />
                <Button x:Name="FilterUnwatchedButton" Content="{loc:Tr Library.Filter.Unwatched}"
                        Tag="Unwatched" Margin="0,0,10,8" Click="OnFilterClicked" />
                <Button x:Name="FilterFavoritesButton" Content="{loc:Tr Library.Filter.Favorites}"
                        Tag="Favorites" Margin="0,0,18,8" Click="OnFilterClicked" />
                <Button x:Name="SortAscendingButton" Content="{loc:Tr Library.Sort.Ascending}"
                        Tag="Ascending" Margin="0,0,10,8" Click="OnSortClicked" />
                <Button x:Name="SortDescendingButton" Content="{loc:Tr Library.Sort.Descending}"
                        Tag="Descending" Margin="0,0,18,8" Click="OnSortClicked" />
                <TextBlock Text="{Binding PageDescription}" VerticalAlignment="Center"
                           Margin="0,0,12,8" AutomationProperties.LiveSetting="Polite" />
            </WrapPanel>
            <TextBlock Classes="secondary" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Classes="secondary" Text="{loc:Tr Library.Empty}" IsVisible="{Binding IsEmpty}" />
            <TextBlock Classes="caption" Text="{Binding ArtworkMessage}"
                       IsVisible="{Binding HasArtworkError}" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="RetryLibraryLoading" Content="{loc:Tr Library.Retry}"
                        Margin="0,0,16,8" Command="{Binding RetryPageCommand}"
                        IsVisible="{Binding CanRetry}" />
                <Button x:Name="RetryLibraryArtwork" Content="{loc:Tr Library.RetryArtwork}"
                        Margin="0,0,16,8" Command="{Binding LoadArtworkCommand}"
                        IsVisible="{Binding CanRetryArtwork}" />
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <ListBox x:Name="LibraryRows" Classes="library-grid" ItemsSource="{Binding Rows}"
                     SelectionMode="Single" IsEnabled="{Binding !IsLoading}"
                     Background="Transparent" BorderThickness="0"
                     Padding="6,4,6,8">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryGridRowViewModel">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{DynamicResource Cindara.Media.GridSpacing}"
                                    Margin="{DynamicResource Cindara.Media.GridCardMargin}">
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{DynamicResource Cindara.Media.GridSpacing}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MediaPreviewCardViewModel">
                                        <StackPanel Spacing="7"
                                                    Width="{DynamicResource Cindara.Media.GridPosterWidth}">
                                            <Button Classes="card"
                                                    Height="{DynamicResource Cindara.Media.GridPosterHeight}"
                                                    HorizontalAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    AutomationProperties.HelpText="{Binding Subtitle}"
                                                    GotFocus="OnCardFocused"
                                                    Click="OnCardClicked">
                                                <Border ClipToBounds="True"
                                                        CornerRadius="{DynamicResource Cindara.Radius.Medium}">
                                                    <Grid>
                                                        <Border IsVisible="{Binding IsArtworkLoading}"
                                                                Background="{DynamicResource Cindara.Brush.SurfaceRaised}"
                                                                Opacity="0.55" />
                                                        <TextBlock Text="{Binding ArtworkPlaceholder}"
                                                                   IsVisible="{Binding ShowArtworkPlaceholder}"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Margin="12" />
                                                        <Image Source="{Binding Artwork}"
                                                               Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                                                       Opacity="{Binding MetadataOpacity}"
                                                       MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Classes="caption"
                                                       Text="{Binding Subtitle}"
                                                       Opacity="{Binding MetadataOpacity}"
                                                       TextWrapping="Wrap" MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding PlaceholderSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{DynamicResource Cindara.Media.GridSpacing}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="7"
                                                    Width="{DynamicResource Cindara.Media.GridPosterWidth}">
                                            <Border Height="{DynamicResource Cindara.Media.GridPosterHeight}"
                                                    Background="{DynamicResource Cindara.Brush.SurfaceRaised}"
                                                    CornerRadius="{DynamicResource Cindara.Radius.Medium}"
                                                    Opacity="0.55" />
                                            <Border Height="20" Background="Transparent" />
                                            <Border Height="16" Background="Transparent" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="RetryLoadingMore"
                                    Width="{DynamicResource Cindara.Media.GridPosterWidth}"
                                    Height="{DynamicResource Cindara.Media.GridPosterHeight}"
                                    IsVisible="{Binding HasRetry}"
                                    Content="{loc:Tr Library.RetryMore}"
                                    Click="OnRetryMoreClicked" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="LetterChoices" Spacing="2" />
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
