<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:vm="using:Cindara.Desktop.ViewModels"
        xmlns:views="using:Cindara.Desktop.Views"
        xmlns:loc="using:Cindara.Desktop.Localization"
        x:Class="Cindara.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="720" MinWidth="720" MinHeight="480"
        WindowState="FullScreen" Title="{loc:Tr Brand.Name}">
    <Grid>
        <Grid x:Name="MainSurface">
            <Viewbox x:Name="ShellViewport" Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Grid Margin="{DynamicResource Cindara.Space.Safe1080}" RowDefinitions="*,Auto" RowSpacing="24">
                        <Grid>
                            <ScrollViewer x:Name="AuthenticationSurface"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Border MinWidth="720" MaxWidth="1100" Padding="{DynamicResource Cindara.Space.Safe1080}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource Cindara.Brush.Surface}"
                                        CornerRadius="{DynamicResource Cindara.Radius.Large}">
                                    <StackPanel Spacing="18">
                                        <TextBlock Classes="display" Text="{loc:Tr Brand.Name}" />
                                        <TextBlock Classes="secondary" Text="{loc:Tr Auth.Tagline}" />
                                        <StackPanel x:Name="ServerEntry" IsVisible="{Binding IsServerEntryVisible}" Spacing="16">
                                            <TextBlock Classes="label" Text="{loc:Tr Auth.Server}" />
                                            <TextBox x:Name="ServerAddressTextBox"
                                                     AutomationProperties.Name="{loc:Tr Auth.ServerAddress}"
                                                     FlowDirection="LeftToRight"
                                                     PlaceholderText="{loc:Tr Auth.ServerExample}"
                                                     Text="{Binding ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Classes="primary" Command="{Binding ConnectCommand}" Content="{loc:Tr Auth.Connect}" />
                                            <Button x:Name="BackToSavedAccountsButton"
                                                    IsVisible="{Binding !!SavedSessions.Count}"
                                                    Command="{Binding BackToSessionsCommand}" Content="{loc:Tr Auth.SavedAccounts}" />
                                        </StackPanel>
                                        <StackPanel x:Name="SignIn" IsVisible="{Binding IsSignInVisible}" Spacing="16">
                                            <TextBlock Classes="label" Text="{loc:Tr Auth.SignInHeading}" />
                                            <TextBox x:Name="UsernameTextBox" AutomationProperties.Name="{loc:Tr Auth.UsernameName}"
                                                     PlaceholderText="{loc:Tr Auth.Username}"
                                                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox AutomationProperties.Name="{loc:Tr Auth.PasswordName}" PasswordChar="*"
                                                     PlaceholderText="{loc:Tr Auth.Password}"
                                                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Classes="primary" Command="{Binding SignInCommand}" Content="{loc:Tr Auth.SignIn}" />
                                            <Button Command="{Binding BackToSessionsCommand}" Content="{loc:Tr Action.Back}" />
                                        </StackPanel>
                                        <StackPanel x:Name="SavedAccounts" IsVisible="{Binding AreSavedSessionsVisible}" Spacing="16">
                                            <TextBlock Classes="label" Text="{loc:Tr Auth.SavedAccounts}" />
                                            <Button x:Name="SavedAccountButton" Click="OnChooseAccount"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    AutomationProperties.Name="{loc:Tr Auth.ChooseSaved}"
                                                    AutomationProperties.HelpText="{Binding SelectedSavedSessionDisplayName}"
                                                    Content="{Binding SelectedSavedSessionDisplayName}" />
                                            <Button Classes="primary" Command="{Binding UseSavedSessionCommand}" Content="{loc:Tr Action.Continue}" />
                                            <Button Command="{Binding RemoveSavedSessionCommand}" Content="{loc:Tr Auth.RemoveSaved}" />
                                            <Button Command="{Binding AddServerCommand}" Content="{loc:Tr Auth.AddServer}" />
                                        </StackPanel>
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="{loc:Tr Auth.StorageNotice}" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                            <views:ShellView x:Name="Shell" IsVisible="False" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <StackPanel Spacing="8">
                                <ProgressBar x:Name="BusyIndicator" Height="3" IsVisible="{Binding IsBusy}"
                                             AutomationProperties.Name="{loc:Tr State.Busy}" />
                                <TextBlock Classes="caption" Text="{loc:Tr State.Busy}" IsVisible="{Binding IsBusy}"
                                           automation:AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Classes="secondary" automation:AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ControllerPrompts" Classes="secondary" TextWrapping="Wrap"
                                           Text="{Binding ControllerStatus}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center" MaxWidth="450">
                                <Button x:Name="CancelLoadingButton" Content="{loc:Tr Action.CancelLoading}"
                                        IsVisible="{Binding ShowDesignGalleryCommand.IsRunning}"
                                        Command="{Binding ShowDesignGalleryCancelCommand}" />
                                <Button x:Name="LanguageButton" Content="{loc:Tr Language.Selection}"
                                        IsVisible="{Binding !IsAuthenticatedVisible}" Click="OnLanguage" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Viewbox>
            <Grid x:Name="GallerySurface" IsVisible="{Binding IsDesignGalleryVisible}">
                <views:DesignGalleryView x:Name="GalleryView" DataContext="{Binding DesignGallery}" />
                <Grid VerticalAlignment="Bottom" ColumnDefinitions="74,*" IsHitTestVisible="False">
                    <Border Grid.Column="1" Background="{DynamicResource Cindara.Brush.Background}" Padding="24,8">
                        <StackPanel>
                            <TextBlock Classes="caption" Text="{loc:Tr Gallery.ReadHelp}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{Binding ControllerStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border x:Name="ModalOverlay" IsVisible="False" Background="#B3080B12"
                AutomationProperties.ControlTypeOverride="Group" AutomationProperties.AccessibilityView="Control">
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Border Classes="dialog" MaxWidth="1200" Margin="{DynamicResource Cindara.Space.Safe1080}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="24">
                            <TextBlock x:Name="ModalTitle" Classes="title"
                                       automation:AutomationProperties.LiveSetting="Assertive" />
                            <ScrollViewer MaxHeight="700" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ModalActions" Spacing="16" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</Window>
