<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:vm="using:Cindara.Desktop.ViewModels"
        xmlns:views="using:Cindara.Desktop.Views"
        x:Class="Cindara.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="720" MinWidth="720" MinHeight="480"
        WindowState="FullScreen" Title="Cindara">
    <Grid>
        <Grid x:Name="MainSurface">
            <Viewbox x:Name="ShellViewport" Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Grid Margin="{DynamicResource Cindara.Space.Safe1080}" RowDefinitions="*,Auto" RowSpacing="24">
                        <Grid>
                            <ScrollViewer x:Name="AuthenticationSurface"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <Border Width="720" Padding="{DynamicResource Cindara.Space.Safe1080}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource Cindara.Brush.Surface}"
                                        CornerRadius="{DynamicResource Cindara.Radius.Large}">
                                    <StackPanel Spacing="18">
                                        <TextBlock Classes="display" Text="Cindara" />
                                        <TextBlock Classes="secondary" Text="Your media. Native everywhere." />
                                        <StackPanel x:Name="ServerEntry" IsVisible="{Binding IsServerEntryVisible}" Spacing="16">
                                            <TextBlock Classes="label" Text="Jellyfin server" />
                                            <TextBox x:Name="ServerAddressTextBox"
                                                     AutomationProperties.Name="Jellyfin server address"
                                                     PlaceholderText="https://jellyfin.example.com"
                                                     Text="{Binding ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Classes="primary" Command="{Binding ConnectCommand}" Content="Connect" />
                                            <Button Command="{Binding BackToSessionsCommand}" Content="Saved accounts" />
                                        </StackPanel>
                                        <StackPanel x:Name="SignIn" IsVisible="{Binding IsSignInVisible}" Spacing="16">
                                            <TextBlock Classes="label" Text="Jellyfin sign in" />
                                            <TextBox x:Name="UsernameTextBox" AutomationProperties.Name="Jellyfin username"
                                                     PlaceholderText="Username"
                                                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox AutomationProperties.Name="Jellyfin password" PasswordChar="*"
                                                     PlaceholderText="Password"
                                                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Classes="primary" Command="{Binding SignInCommand}" Content="Sign in" />
                                            <Button Command="{Binding BackToSessionsCommand}" Content="Back" />
                                        </StackPanel>
                                        <StackPanel x:Name="SavedAccounts" IsVisible="{Binding AreSavedSessionsVisible}" Spacing="16">
                                            <TextBlock Classes="label" Text="Saved accounts" />
                                            <Button x:Name="SavedAccountButton" Click="OnChooseAccount"
                                                    IsEnabled="{Binding !IsBusy}"
                                                    AutomationProperties.Name="Choose saved Jellyfin account"
                                                    Content="{Binding SelectedSavedSession.DisplayName}" />
                                            <Button Classes="primary" Command="{Binding UseSavedSessionCommand}" Content="Continue" />
                                            <Button Command="{Binding RemoveSavedSessionCommand}" Content="Remove saved account" />
                                            <Button Command="{Binding AddServerCommand}" Content="Add another server" />
                                        </StackPanel>
                                        <TextBlock Classes="caption" TextWrapping="Wrap"
                                                   Text="Passwords are never saved. Tokens use your operating system's protected storage." />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                            <views:ShellView x:Name="Shell" IsVisible="False" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <StackPanel Spacing="8">
                                <ProgressBar Height="3" IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                                <TextBlock Classes="secondary" automation:AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ControllerPrompts" Classes="secondary" TextWrapping="Wrap"
                                           Text="{Binding ControllerStatus}" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="WindowOptionsButton" Content="Window / exit"
                                    VerticalAlignment="Center" Click="OnWindowOptions" />
                        </Grid>
                    </Grid>
                </Grid>
            </Viewbox>
            <Grid x:Name="GallerySurface" IsVisible="{Binding IsDesignGalleryVisible}">
                <views:DesignGalleryView x:Name="GalleryView" DataContext="{Binding DesignGallery}" />
                <Button x:Name="GalleryBackButton" Margin="0,24,24,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding HideDesignGalleryCommand}" Content="Back to Home" />
                <Border VerticalAlignment="Bottom" Background="{DynamicResource Cindara.Brush.Background}"
                        Padding="24,8" IsHitTestVisible="False">
                    <TextBlock Classes="caption" Text="{Binding ControllerStatus}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>
        <Border x:Name="ModalOverlay" IsVisible="False" Background="#B3080B12">
            <Viewbox Stretch="Uniform">
                <Grid Width="1920" Height="1080">
                    <Border Classes="dialog" MaxWidth="1200" Margin="{DynamicResource Cindara.Space.Safe1080}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="24">
                            <TextBlock x:Name="ModalTitle" Classes="title" />
                            <ScrollViewer MaxHeight="700" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ModalActions" Spacing="16" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</Window>
