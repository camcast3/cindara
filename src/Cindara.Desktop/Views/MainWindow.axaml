<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:vm="using:Cindara.Desktop.ViewModels"
        xmlns:views="using:Cindara.Desktop.Views"
        xmlns:models="using:Cindara.Core.Models"
        xmlns:auth="using:Cindara.Core.Authentication"
        xmlns:loc="using:Cindara.Desktop.Localization"
        x:Class="Cindara.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="720" MinWidth="720" MinHeight="480"
        WindowState="FullScreen" Title="{loc:Tr Brand.Name}">
    <Window.Resources>
        <Thickness x:Key="Cindara.Adaptive.SafeMargin">24</Thickness>
        <x:Double x:Key="Cindara.Adaptive.ContentSpacing">24</x:Double>
        <x:Double x:Key="Cindara.Adaptive.DialogMaxHeight">640</x:Double>
        <x:Double x:Key="Cindara.Adaptive.FormMaxWidth">800</x:Double>
    </Window.Resources>
    <Grid>
        <Grid x:Name="MainSurface">
            <Grid x:Name="ShellViewport">
                    <Grid Margin="{DynamicResource Cindara.Adaptive.SafeMargin}" RowDefinitions="*,Auto"
                          RowSpacing="{DynamicResource Cindara.Adaptive.ContentSpacing}">
                        <Grid>
                            <ScrollViewer x:Name="AuthenticationSurface"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <Grid MinHeight="620">
                                    <Border CornerRadius="{DynamicResource Cindara.Radius.Large}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#142C3A" Offset="0" />
                                                <GradientStop Color="#0A111E" Offset="0.45" />
                                                <GradientStop Color="#111D2E" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="{loc:Tr Brand.Name}" Classes="heading"
                                               Margin="36" HorizontalAlignment="Left"
                                               VerticalAlignment="Top" />
                                    <Border x:Name="AuthenticationCard"
                                            MaxWidth="{DynamicResource Cindara.Adaptive.FormMaxWidth}"
                                            Padding="36"
                                            Margin="{DynamicResource Cindara.Adaptive.SafeMargin}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#F0111A29"
                                            BorderBrush="{DynamicResource Cindara.Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Cindara.Radius.Large}">
                                        <StackPanel Spacing="18">
                                            <TextBlock x:Name="AuthenticationProgress"
                                                       Classes="caption" />

                                            <StackPanel x:Name="ServerSelection"
                                                        IsVisible="{Binding IsServerSelectionVisible}"
                                                        Spacing="16">
                                                <TextBlock Classes="title"
                                                           Text="{loc:Tr Auth.ChooseServer}" />
                                                <TextBlock Classes="secondary"
                                                           Text="{loc:Tr Auth.ChooseServerHelp}"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl x:Name="SavedServersList"
                                                              ItemsSource="{Binding SavedServers}"
                                                              IsEnabled="{Binding !IsBusy}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="10" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ServerIdentity">
                                                            <Button Classes="settings-action"
                                                                    HorizontalAlignment="Stretch"
                                                                    Click="OnSelectServer"
                                                                    AutomationProperties.Name="{Binding DisplayName}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayName}" />
                                                                    <TextBlock Classes="caption"
                                                                               Text="{Binding BaseUri}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button x:Name="AddServerFromSelectionButton"
                                                        Command="{Binding AddServerCommand}"
                                                        Content="{loc:Tr Auth.AddServer}" />
                                            </StackPanel>

                                            <StackPanel x:Name="ServerEntry"
                                                        IsVisible="{Binding IsServerEntryVisible}"
                                                        Spacing="16">
                                                <TextBlock Classes="title"
                                                           Text="{loc:Tr Auth.Server}" />
                                                <TextBlock Classes="secondary"
                                                           Text="{loc:Tr Auth.ServerHelp}"
                                                           TextWrapping="Wrap" />
                                                <TextBox x:Name="ServerAddressTextBox"
                                                         AutomationProperties.Name="{loc:Tr Auth.ServerAddress}"
                                                         FlowDirection="LeftToRight"
                                                         PlaceholderText="{loc:Tr Auth.ServerExample}"
                                                         Text="{Binding ServerAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Classes="primary"
                                                        Command="{Binding ConnectCommand}"
                                                        Content="{loc:Tr Auth.Connect}" />
                                                <Button x:Name="BackToSavedAccountsButton"
                                                        IsVisible="{Binding !!SavedSessions.Count}"
                                                        Command="{Binding BackToSessionsCommand}"
                                                        Content="{loc:Tr Action.Back}" />
                                            </StackPanel>

                                            <StackPanel x:Name="SavedAccounts"
                                                        IsVisible="{Binding AreSavedSessionsVisible}"
                                                        Spacing="16">
                                                <TextBlock Classes="title"
                                                           Text="{loc:Tr Auth.ChooseAccount}" />
                                                <TextBlock Classes="secondary"
                                                           Text="{loc:Tr Auth.ChooseAccountHelp}"
                                                           TextWrapping="Wrap" />
                                                <ItemsControl x:Name="SavedAccountsList"
                                                              ItemsSource="{Binding ServerAccounts}"
                                                              IsEnabled="{Binding !IsBusy}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="10" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="auth:SessionProfile">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                                <Button Classes="settings-action"
                                                                        HorizontalAlignment="Stretch"
                                                                        Click="OnUseSavedAccount"
                                                                        AutomationProperties.Name="{Binding Username}"
                                                                        Content="{Binding Username}" />
                                                                <Button Grid.Column="1"
                                                                        Click="OnRemoveSavedAccount"
                                                                        AutomationProperties.Name="{loc:Tr Auth.RemoveSaved}"
                                                                        AutomationProperties.HelpText="{Binding Username}"
                                                                        Content="{loc:Tr Auth.RemoveSaved}" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button x:Name="AddAccountButton"
                                                        Command="{Binding AddAccountCommand}"
                                                        Content="{loc:Tr Auth.AddAccount}" />
                                                <Button Command="{Binding BackToSessionsCommand}"
                                                        Content="{loc:Tr Action.Back}" />
                                            </StackPanel>

                                            <StackPanel x:Name="SignIn"
                                                        IsVisible="{Binding IsSignInVisible}"
                                                        Spacing="16">
                                                <TextBlock Classes="title"
                                                           Text="{loc:Tr Auth.SignInHeading}" />
                                                <TextBlock Classes="secondary"
                                                           Text="{loc:Tr Auth.SignInHelp}"
                                                           TextWrapping="Wrap" />
                                                <TextBox x:Name="UsernameTextBox"
                                                         AutomationProperties.Name="{loc:Tr Auth.UsernameName}"
                                                         PlaceholderText="{loc:Tr Auth.Username}"
                                                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox AutomationProperties.Name="{loc:Tr Auth.PasswordName}"
                                                         PasswordChar="*"
                                                         PlaceholderText="{loc:Tr Auth.Password}"
                                                         Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Classes="primary"
                                                        Command="{Binding SignInCommand}"
                                                        Content="{loc:Tr Auth.SignIn}" />
                                                <Button Command="{Binding BackToSessionsCommand}"
                                                        Content="{loc:Tr Action.Back}" />
                                            </StackPanel>

                                            <TextBlock Classes="caption" TextWrapping="Wrap"
                                                       Text="{loc:Tr Auth.StorageNotice}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                            <views:ShellView x:Name="Shell" IsVisible="False" />
                        </Grid>
                        <Grid x:Name="ShellFooter" Grid.Row="1" ColumnDefinitions="*,Auto"
                              ColumnSpacing="{DynamicResource Cindara.Adaptive.ContentSpacing}"
                              RowSpacing="12">
                            <StackPanel Spacing="8">
                                <ProgressBar x:Name="BusyIndicator" Height="3" IsVisible="{Binding IsBusy}"
                                             AutomationProperties.Name="{loc:Tr State.Busy}" />
                                <TextBlock Classes="caption" Text="{loc:Tr State.Busy}" IsVisible="{Binding IsBusy}"
                                           automation:AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Classes="secondary" automation:AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ControllerPrompts" Classes="secondary" TextWrapping="Wrap"
                                           Text="{Binding ControllerStatus}" />
                            </StackPanel>
                            <StackPanel x:Name="FooterActions" Grid.Column="1" Spacing="12"
                                        VerticalAlignment="Center" MaxWidth="450">
                                <Button x:Name="CancelLoadingButton" Content="{loc:Tr Action.CancelLoading}"
                                        IsVisible="{Binding ShowDesignGalleryCommand.IsRunning}"
                                        Command="{Binding ShowDesignGalleryCancelCommand}" />
                                <Button x:Name="LanguageButton" Content="{loc:Tr Language.Selection}"
                                        IsVisible="{Binding !IsAuthenticatedVisible}" Click="OnLanguage" />
                                <Button x:Name="DiagnosticsButton" Content="{loc:Tr Diagnostics.Title}"
                                        Click="OnDiagnostics" />
                            </StackPanel>
                        </Grid>
                    </Grid>
            </Grid>
            <Grid x:Name="GallerySurface" IsVisible="{Binding IsDesignGalleryVisible}">
                <views:DesignGalleryView x:Name="GalleryView" DataContext="{Binding DesignGallery}" />
                <Grid x:Name="GalleryFooter" VerticalAlignment="Bottom" ColumnDefinitions="96,*"
                      IsHitTestVisible="False">
                    <Border Grid.Column="1" Background="{DynamicResource Cindara.Brush.Background}" Padding="24,8">
                        <StackPanel>
                            <TextBlock x:Name="GalleryReadHelp" Classes="caption"
                                       Text="{loc:Tr Gallery.ReadHelp}" TextWrapping="Wrap" />
                            <TextBlock x:Name="GalleryControllerPrompts" Classes="caption"
                                       Text="{Binding ControllerStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
        <Border x:Name="ModalOverlay" IsVisible="False" Background="#B3080B12"
                AutomationProperties.ControlTypeOverride="Group" AutomationProperties.AccessibilityView="Control">
            <Grid>
                    <Border x:Name="ModalDialog" Classes="dialog" MaxWidth="1200"
                            Margin="{DynamicResource Cindara.Adaptive.SafeMargin}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="24">
                            <TextBlock x:Name="ModalTitle" Classes="title"
                                       automation:AutomationProperties.LiveSetting="Assertive" />
                            <ScrollViewer MaxHeight="{DynamicResource Cindara.Adaptive.DialogMaxHeight}"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ModalActions" Spacing="16" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
