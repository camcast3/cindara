<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cindara.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="620"
        x:Class="Cindara.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="960"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        Title="Cindara">

    <Grid Background="#0B1020">
        <Border Width="560"
               Padding="48"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Background="#161D31"
               BorderBrush="#28334F"
               BorderThickness="1"
               CornerRadius="20">
            <StackPanel Spacing="18">
               <TextBlock FontSize="38"
                          FontWeight="Bold"
                          Foreground="#F7F9FF"
                          Text="Cindara" />
               <TextBlock Margin="0,-10,0,12"
                          FontSize="16"
                          Foreground="#AEBAD4"
                          Text="Your media. Native everywhere." />
               <TextBlock FontWeight="SemiBold"
                          Foreground="#E7ECF8"
                          Text="Jellyfin server" />
               <TextBox PlaceholderText="https://jellyfin.example.com"
                        x:Name="ServerAddressTextBox"
                        Text="{Binding ServerAddress}" />
               <Button Padding="20,12"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Command="{Binding ConnectCommand}"
                       Content="Connect" />
               <ProgressBar Height="3"
                            IsIndeterminate="{Binding IsConnecting}"
                            IsVisible="{Binding IsConnecting}" />
               <Border Padding="14"
                       Background="#202A43"
                       CornerRadius="8">
                   <TextBlock Foreground="#C9D3E8"
                              Text="{Binding StatusMessage}"
                              TextWrapping="Wrap" />
               </Border>
               <TextBlock FontSize="12"
                          Foreground="#7F8CA8"
                          Text="Cindara checks the public Jellyfin system endpoint. No credentials are sent."
                          TextWrapping="Wrap" />
               <TextBlock FontSize="12"
                          Foreground="#7F8CA8"
                          Text="{Binding ControllerStatus}"
                          TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
