<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Cindara.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="620"
        x:Class="Cindara.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="960"
        Height="620"
        MinWidth="720"
        MinHeight="480"
        Title="Cindara">

    <Grid Background="#0B1020">
        <Border Width="560"
               Padding="48"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Background="#161D31"
               BorderBrush="#28334F"
               BorderThickness="1"
               CornerRadius="20">
            <StackPanel Spacing="18">
               <TextBlock FontSize="38"
                          FontWeight="Bold"
                          Foreground="#F7F9FF"
                          Text="Cindara" />
               <TextBlock Margin="0,-10,0,12"
                          FontSize="16"
                          Foreground="#AEBAD4"
                          Text="Your media. Native everywhere." />
               <StackPanel IsVisible="{Binding IsServerEntryVisible}"
                           Spacing="12">
                   <TextBlock FontWeight="SemiBold"
                              Foreground="#E7ECF8"
                              Text="Jellyfin server" />
                   <TextBox PlaceholderText="https://jellyfin.example.com"
                            x:Name="ServerAddressTextBox"
                            Text="{Binding ServerAddress}" />
                   <Button Padding="20,12"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           Command="{Binding ConnectCommand}"
                           Content="Connect" />
               </StackPanel>
               <StackPanel IsVisible="{Binding IsSignInVisible}"
                           Spacing="12">
                   <TextBlock FontWeight="SemiBold"
                              Foreground="#E7ECF8"
                              Text="Jellyfin sign in" />
                   <TextBox AutomationProperties.Name="Jellyfin username"
                            PlaceholderText="Username"
                            Text="{Binding Username}" />
                   <TextBox AutomationProperties.Name="Jellyfin password"
                            PasswordChar="*"
                            PlaceholderText="Password"
                            Text="{Binding Password}" />
                   <Button Padding="20,12"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           Command="{Binding SignInCommand}"
                           Content="Sign in" />
                   <Button Command="{Binding BackToSessionsCommand}"
                           Content="Back" />
               </StackPanel>
               <StackPanel IsVisible="{Binding AreSavedSessionsVisible}"
                           Spacing="12">
                   <TextBlock FontWeight="SemiBold"
                              Foreground="#E7ECF8"
                              Text="Saved accounts" />
                   <ComboBox x:Name="SavedSessionsComboBox"
                             ItemsSource="{Binding SavedSessions}"
                             SelectedItem="{Binding SelectedSavedSession}">
                       <ComboBox.ItemTemplate>
                           <DataTemplate>
                               <TextBlock Text="{Binding DisplayName}" />
                           </DataTemplate>
                       </ComboBox.ItemTemplate>
                   </ComboBox>
                   <Button Padding="20,12"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           Command="{Binding UseSavedSessionCommand}"
                           Content="Continue" />
                   <Button Command="{Binding RemoveSavedSessionCommand}"
                           Content="Remove saved account" />
                   <Button Command="{Binding AddServerCommand}"
                           Content="Add another server" />
               </StackPanel>
               <StackPanel IsVisible="{Binding IsAuthenticatedVisible}"
                           Spacing="12">
                   <TextBlock FontSize="20"
                              FontWeight="SemiBold"
                              Foreground="#E7ECF8"
                              Text="{Binding AuthenticatedAccount}" />
                   <TextBlock Foreground="#AEBAD4"
                              Text="Your secure Jellyfin session is ready." />
                   <Button Command="{Binding LogoutCommand}"
                           Content="Sign out" />
                   <Button Command="{Binding BackToSessionsCommand}"
                           Content="Switch account" />
               </StackPanel>
               <ProgressBar Height="3"
                            IsIndeterminate="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}" />
               <Border Padding="14"
                       Background="#202A43"
                       CornerRadius="8">
                   <TextBlock Foreground="#C9D3E8"
                              Text="{Binding StatusMessage}"
                              TextWrapping="Wrap" />
               </Border>
               <TextBlock FontSize="12"
                          Foreground="#7F8CA8"
                          Text="Passwords are never saved. Access tokens use your operating system's protected credential storage."
                          TextWrapping="Wrap" />
               <TextBlock FontSize="12"
                          Foreground="#7F8CA8"
                          Text="{Binding ControllerStatus}"
                          TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
