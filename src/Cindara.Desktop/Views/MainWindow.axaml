<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        xmlns:vm="using:Cindara.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="720"
        x:Class="Cindara.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Title="Cindara">

    <ScrollViewer Background="{DynamicResource Cindara.Brush.Background}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Border Width="600"
               Margin="{DynamicResource Cindara.Space.Safe1080}"
               Padding="{DynamicResource Cindara.Space.Safe1080}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Background="{DynamicResource Cindara.Brush.Surface}"
               BorderBrush="{DynamicResource Cindara.Brush.Border}"
               BorderThickness="1"
               CornerRadius="{DynamicResource Cindara.Radius.Large}"
               BoxShadow="0 20 60 0 #73000000">
            <StackPanel Spacing="18">
               <TextBlock Classes="display"
                          Text="Cindara" />
               <TextBlock Margin="0,-10,0,12"
                          Classes="secondary"
                          Text="Your media. Native everywhere." />
               <TextBlock Classes="label"
                          Text="Jellyfin server" />
               <TextBox PlaceholderText="https://jellyfin.example.com"
                        x:Name="ServerAddressTextBox"
                        Text="{Binding ServerAddress}" />
               <Button Padding="20,12"
                       Classes="primary"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Command="{Binding ConnectCommand}"
                       Content="Connect" />
               <ProgressBar Height="3"
                            IsIndeterminate="{Binding IsConnecting}"
                            IsVisible="{Binding IsConnecting}" />
               <Border Padding="14"
                       Classes="toast"
                       CornerRadius="{DynamicResource Cindara.Radius.Small}">
                   <TextBlock Foreground="{DynamicResource Cindara.Brush.Text}"
                              automation:AutomationProperties.LiveSetting="Polite"
                              Text="{Binding StatusMessage}"
                              TextWrapping="Wrap" />
               </Border>
               <TextBlock Classes="caption"
                          Text="Cindara checks the public Jellyfin system endpoint. No credentials are sent."
                          TextWrapping="Wrap" />
               <TextBlock Classes="caption"
                          Text="{Binding ControllerStatus}"
                          TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
