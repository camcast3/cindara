<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cindara.Desktop.ViewModels"
             xmlns:loc="using:Cindara.Desktop.Localization"
             x:Class="Cindara.Desktop.Views.MovieDetailsView"
             x:DataType="vm:MediaDetailsViewModel"
             Background="{DynamicResource Cindara.Brush.Background}">
    <UserControl.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.cast-card">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.cast-card:pointerover:not(:focus) /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <Image Source="{Binding Backdrop}" Stretch="UniformToFill" Opacity="0.25" />
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#A0080B12" Offset="0" />
                    <GradientStop Color="#E6080B12" Offset="0.65" />
                    <GradientStop Color="#FF080B12" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid RowDefinitions="Auto,Auto,*" Margin="{DynamicResource Cindara.Adaptive.SafeMargin}"
              RowSpacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                <Button x:Name="DetailsBack" Content="{loc:Tr Action.Back}"
                        IsEnabled="{Binding CanClose}" Click="OnBack"
                        AutomationProperties.AutomationId="MovieDetailsBack" />
                <TextBlock Grid.Column="1" Text="{loc:Tr Details.Movie}" Classes="heading"
                           VerticalAlignment="Center" MaxLines="1" TextTrimming="CharacterEllipsis" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12"
                  IsVisible="{Binding HasMessage}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Content="{loc:Tr Details.Retry}" Command="{Binding RefreshCommand}"
                        IsVisible="{Binding NeedsRetry}" AutomationProperties.AutomationId="MovieRetry" />
            </Grid>
            <Grid x:Name="MovieBody" Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="12"
                  IsVisible="{Binding HasDetails}">
                <Grid x:Name="MovieHeading" ColumnDefinitions="Auto,*" ColumnSpacing="32">
                    <Border x:Name="MoviePoster"
                            Width="{DynamicResource Cindara.Details.PosterWidth}"
                            Height="{DynamicResource Cindara.Details.PosterHeight}"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Cindara.Brush.SurfaceRaised}"
                            CornerRadius="{DynamicResource Cindara.Radius.Large}"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="{loc:Tr Library.ArtworkUnavailable}" IsVisible="{Binding !HasPoster}"
                                       Margin="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Image Source="{Binding Poster}" Stretch="UniformToFill" />
                            <Border x:Name="WatchedBadge" IsVisible="{Binding HasKnownUserState}"
                                    Background="{DynamicResource Cindara.Brush.Surface}"
                                    CornerRadius="22" Padding="10" Margin="12"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    AutomationProperties.Name="{Binding WatchedState}"
                                    AutomationProperties.AutomationId="MovieWatchedBadge">
                                <Grid Width="22" Height="22">
                                    <Ellipse IsVisible="{Binding IsUnwatched}" StrokeThickness="2"
                                             Stroke="{DynamicResource Cindara.Brush.TextSecondary}" />
                                    <Path IsVisible="{Binding IsWatched}" Data="M 2,11 L 8,17 L 20,4"
                                          StrokeThickness="3" Stroke="{DynamicResource Cindara.Brush.Accent}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid x:Name="MovieCopy" Grid.Column="1" RowDefinitions="*,Auto,Auto"
                          RowSpacing="16" VerticalAlignment="Center">
                    <Grid x:Name="MovieInformation"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
                        <TextBlock Text="{Binding Title}" Classes="title" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="MovieDetailsTitle" />
                        <TextBlock Grid.Row="1" Text="{Binding Metadata}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="GenrePreview" Grid.Row="2" Text="{Binding Genres}" Classes="secondary"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Text="{Binding Ratings}" MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DirectorPreview" Grid.Row="4" Text="{Binding DirectorSummary}" Classes="secondary"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="SynopsisPreview" Grid.Row="5" Text="{Binding Overview}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="4"
                                   MaxWidth="{DynamicResource Cindara.Details.ReadingWidth}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True" />
                    </Grid>
                    <Grid x:Name="MovieActions" Grid.Row="1"
                          RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <WrapPanel>
                            <TextBlock x:Name="WatchedPreview" Text="{Binding WatchedState}" Classes="secondary" Margin="0,0,20,0"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding PlaybackState}" Classes="secondary"
                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                        </WrapPanel>
                        <Grid x:Name="MediaSummary" Grid.Row="1" ColumnDefinitions="*,2*,2*" ColumnSpacing="24"
                              MaxWidth="{DynamicResource Cindara.Details.ReadingWidth}" HorizontalAlignment="Left">
                            <StackPanel x:Name="VideoSummaryPanel" Spacing="4">
                                <TextBlock Text="{loc:Tr Details.Video}" Classes="caption" MaxLines="1" />
                                <TextBlock x:Name="VideoSummaryText" Text="{Binding Video}" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="MovieVideoSummary" />
                            </StackPanel>
                            <StackPanel x:Name="AudioSummaryPanel" Grid.Column="1" Spacing="4">
                                <TextBlock Text="{loc:Tr Details.Audio}" Classes="caption" MaxLines="1" />
                                <TextBlock x:Name="AudioSummaryText" Text="{Binding Audio}" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="MovieAudioSummary" />
                            </StackPanel>
                            <StackPanel x:Name="SubtitleSummaryPanel" Grid.Column="2" Spacing="4">
                                <TextBlock Text="{loc:Tr Details.Subtitles}" Classes="caption" MaxLines="1" />
                                <TextBlock x:Name="SubtitleSummaryText" Text="{Binding Subtitles}" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="MovieSubtitleSummary" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PlaybackNotice" Grid.Row="2" Text="{loc:Tr Details.PlaybackSettingsUnavailable}" Classes="caption"
                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                    </Grid>
                        <WrapPanel x:Name="MovieButtons" Grid.Row="2">
                            <Button x:Name="FavoriteButton" Content="{Binding FavoriteLabel}"
                                    Command="{Binding ToggleFavoriteCommand}" Margin="0,0,12,0"
                                    AutomationProperties.AutomationId="MovieFavorite" />
                            <Button x:Name="WatchedButton" Command="{Binding ToggleWatchedCommand}" Margin="0,0,12,0"
                                    AutomationProperties.Name="{Binding WatchedLabel}"
                                    AutomationProperties.ItemStatus="{Binding WatchedState}"
                                    AutomationProperties.AutomationId="MovieWatched">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Grid Width="18" Height="18" IsVisible="{Binding HasKnownUserState}"
                                          VerticalAlignment="Center">
                                        <Ellipse x:Name="UnwatchedActionIndicator" IsVisible="{Binding IsUnwatched}"
                                                 StrokeThickness="2" Stroke="{DynamicResource Cindara.Brush.TextSecondary}" />
                                        <Path x:Name="WatchedActionIndicator" IsVisible="{Binding IsWatched}"
                                              Data="M 1,9 L 6,14 L 17,3" StrokeThickness="3"
                                              Stroke="{DynamicResource Cindara.Brush.Accent}" />
                                    </Grid>
                                    <TextBlock Text="{Binding WatchedLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SynopsisButton" Content="{loc:Tr Details.MoreInformation}"
                                    Click="OnInformation" IsEnabled="{Binding CanClose}" Margin="0,0,12,0"
                                    AutomationProperties.AutomationId="MovieMoreInformation" />
                            <Button x:Name="CreditsButton" Content="{loc:Tr Details.Credits}"
                                    Click="OnCredits" IsEnabled="{Binding CanClose}"
                                    AutomationProperties.AutomationId="MovieCredits" />
                        </WrapPanel>
                    </Grid>
                </Grid>
                <Grid x:Name="CastSection" Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8"
                      Height="{DynamicResource Cindara.Details.CastHeight}">
                    <TextBlock x:Name="CastHeading" Text="{loc:Tr Details.Cast}" Classes="heading" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="{loc:Tr Details.NoCast}" IsVisible="{Binding !HasCast}" />
                    <ScrollViewer x:Name="CastScroll" Grid.Row="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasCast}">
                        <ItemsControl ItemsSource="{Binding Cast}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="16" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MovieCreditViewModel">
                                    <Grid Width="{DynamicResource Cindara.Details.CreditWidth}"
                                          RowDefinitions="*,Auto,Auto" RowSpacing="4"
                                          Height="{DynamicResource Cindara.Details.CreditHeight}">
                                        <Button Classes="card cast-card"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}"
                                                AutomationProperties.HelpText="{Binding Role}"
                                                GotFocus="OnCastFocused" Click="OnCastSelected">
                                            <Border x:Name="CastArtworkFrame"
                                                    CornerRadius="{DynamicResource Cindara.Radius.Medium}"
                                                    Background="{DynamicResource Cindara.Brush.SurfaceRaised}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{loc:Tr Details.NoPhoto}" IsVisible="{Binding !HasImage}"
                                                               TextWrapping="Wrap" TextAlignment="Center" Margin="8"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2" Text="{Binding Role}" Classes="caption"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
