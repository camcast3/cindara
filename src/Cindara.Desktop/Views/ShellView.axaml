<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Cindara.Desktop.ViewModels"
             xmlns:views="using:Cindara.Desktop.Views"
             xmlns:loc="using:Cindara.Desktop.Localization"
             x:Class="Cindara.Desktop.Views.ShellView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Cindara.Adaptive.ContentSpacing}">
        <Grid x:Name="DestinationHeader" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18">
            <Button x:Name="DestinationBackButton" Width="56" Height="56"
                    AutomationProperties.Name="{loc:Tr Action.Back}"
                    Click="OnBackClicked">
                <PathIcon Width="24" Height="24"
                          Data="M 15,4 L 7,12 L 15,20 L 13,22 L 3,12 L 13,2 Z" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="DestinationEyebrow" Classes="caption"
                           Text="{loc:Tr Brand.Name}" />
                <TextBlock x:Name="DestinationTitle" Classes="display" />
            </StackPanel>
            <TextBlock x:Name="DestinationBrand" Grid.Column="2" Classes="heading"
                       VerticalAlignment="Center"
                       Text="{loc:Tr Brand.Name}" />
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="HomePage" Spacing="24">
                        <Border Classes="hero">
                            <StackPanel Spacing="24">
                                <TextBlock Classes="secondary" TextWrapping="Wrap"
                                           Text="{Binding StatusMessage}" />
                                <Button x:Name="RetryHomeButton" Classes="primary"
                                        IsVisible="{Binding !IsBusy}"
                                        Command="{Binding OpenHomeCommand}"
                                        Content="{loc:Tr Home.Retry}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PlaceholderPage" IsVisible="False" Spacing="24">
                        <Border Classes="hero">
                            <TextBlock x:Name="DestinationMessage" Classes="secondary"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="SettingsPage" IsVisible="False" Spacing="24"
                                HorizontalAlignment="Stretch">
                        <Grid x:Name="SettingsWorkspace" ColumnDefinitions="250,*"
                              ColumnSpacing="{DynamicResource Cindara.Adaptive.ContentSpacing}">
                            <Border Classes="settings-card">
                                <ScrollViewer x:Name="SettingsCategoryScroll"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="SettingsCategories" Spacing="8">
                                    <Button x:Name="SettingsPreferencesCategory"
                                            Classes="settings-action"
                                            HorizontalAlignment="Stretch"
                                            Content="{loc:Tr Settings.Preferences}"
                                            Click="OnSettingsCategoryClicked"
                                            GotFocus="OnSettingsCategoryFocused"
                                            Tag="Preferences" />
                                    <Button x:Name="SettingsLibraryCategory"
                                            Classes="settings-action"
                                            HorizontalAlignment="Stretch"
                                            Content="{loc:Tr LibraryLayout.Title}"
                                            Click="OnSettingsCategoryClicked"
                                            GotFocus="OnSettingsCategoryFocused"
                                            Tag="Library" />
                                    <Button x:Name="SettingsApplicationCategory"
                                            Classes="settings-action"
                                            HorizontalAlignment="Stretch"
                                            Content="{loc:Tr Settings.Application}"
                                            Click="OnSettingsCategoryClicked"
                                            GotFocus="OnSettingsCategoryFocused"
                                            Tag="Application" />
                                    <Button x:Name="SettingsDiagnosticsCategory"
                                            Classes="settings-action"
                                            HorizontalAlignment="Stretch"
                                            Content="{loc:Tr Diagnostics.Title}"
                                            Click="OnSettingsCategoryClicked"
                                            GotFocus="OnSettingsCategoryFocused"
                                            Tag="Diagnostics" />
                                </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border x:Name="SettingsDetail" Grid.Column="1"
                                    Classes="settings-card">
                                <StackPanel>
                                    <StackPanel x:Name="SettingsPreferencesPanel" Spacing="16">
                                        <TextBlock Classes="heading"
                                                   Text="{loc:Tr Settings.Preferences}" />
                                        <TextBlock Classes="secondary"
                                                   Text="{loc:Tr Settings.PreferencesHelp}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel x:Name="SettingsActions" Spacing="16">
                                            <Button x:Name="SettingsLanguageButton"
                                                    Classes="settings-action"
                                                    HorizontalAlignment="Stretch"
                                                    Content="{loc:Tr Language.Selection}"
                                                    Click="OnLanguageClicked" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="SettingsLibraryPanel" Spacing="16"
                                                IsVisible="False">
                                        <TextBlock Classes="heading"
                                                   Text="{loc:Tr LibraryLayout.Title}" />
                                        <TextBlock Classes="secondary"
                                                   Text="{loc:Tr LibraryLayout.Scope}"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="SettingsLibraryLayoutButton"
                                                Classes="settings-action"
                                                HorizontalAlignment="Stretch"
                                                IsEnabled="{Binding HasLibraryLayout}"
                                                Content="{loc:Tr LibraryLayout.Title}"
                                                Click="OnLibraryLayoutClicked" />
                                    </StackPanel>

                                    <StackPanel x:Name="SettingsApplicationPanel" Spacing="16"
                                                IsVisible="False">
                                        <TextBlock Classes="heading"
                                                   Text="{loc:Tr Settings.Application}" />
                                        <TextBlock Classes="secondary"
                                                   Text="{loc:Tr Settings.ApplicationHelp}"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="ExitButton" Classes="settings-action"
                                                HorizontalAlignment="Stretch"
                                                Content="{loc:Tr Action.Exit}"
                                                Click="OnExitClicked" />
                                        <Button x:Name="BackHomeButton" Classes="settings-action"
                                                HorizontalAlignment="Stretch"
                                                Content="{loc:Tr Nav.BackHome}"
                                                Click="OnHomeClicked" />
                                    </StackPanel>

                                    <StackPanel x:Name="SettingsDiagnosticsPanel" Spacing="16"
                                                IsVisible="False">
                                        <TextBlock Classes="heading"
                                                   Text="{loc:Tr Diagnostics.Title}" />
                                        <TextBlock Classes="secondary"
                                                   Text="{loc:Tr Diagnostics.Privacy}"
                                                   TextWrapping="Wrap" />
                                        <Button x:Name="OpenDiagnosticsButton"
                                                Classes="settings-action"
                                                HorizontalAlignment="Stretch"
                                                Content="{loc:Tr Diagnostics.Title}"
                                                Click="OnDiagnosticsClicked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <Grid x:Name="LibrariesPage" IsVisible="False">
                <Grid IsVisible="{Binding HasLibraryBrowser}">
                    <views:LibraryBrowserView x:Name="LibraryView"
                                              DataContext="{Binding LibraryBrowser}" />
                </Grid>
                <StackPanel x:Name="LibrariesUnavailable" Spacing="24"
                            IsVisible="{Binding !HasLibraryBrowser}">
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <Button Content="{loc:Tr Home.Retry}"
                            Command="{Binding OpenHomeCommand}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="SearchPage" IsVisible="False">
                <Grid IsVisible="{Binding HasSearchBrowser}">
                    <views:SearchBrowserView x:Name="SearchView"
                                             DataContext="{Binding SearchBrowser}" />
                </Grid>
                <StackPanel Spacing="24" IsVisible="{Binding !HasSearchBrowser}">
                    <TextBlock Text="{loc:Tr Search.Unavailable}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
